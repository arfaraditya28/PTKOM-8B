{
  "name": "ptkom-8b",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:setup": "prisma generate && prisma db push && npm run db:sync-counters && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx scripts/integration.ts",
    "test:http": "node --import tsx scripts/test-http.ts",
    "env:setup": "node --import tsx scripts/setup-env.ts",
    "verify": "npm run lint && npm test && npm run test:embedded && npm run build && npm run typecheck",
    "db:sync-counters": "node --import tsx scripts/sync-counters.ts",
    "test:embedded": "node --import tsx tests/embedded.ts",
    "backend:check": "node --import tsx scripts/check-backend.ts"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@next/env": "16.3.5",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "next": "16.3.5",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "pglite-prisma-adapter": "0.6.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "pglite-prisma-adapter": {
      "@prisma/driver-adapter-utils": "6.19.3"
    }
  }
}
