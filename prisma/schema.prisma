// Database: PostgreSQL (Neon) untuk semua environment.
// Struktur tabel mengikuti docs/DATABASE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PETUGAS
  ADMIN
}

enum ReportStatus {
  DIAJUKAN
  DIVERIFIKASI
  DIPROSES
  SELESAI
  DITOLAK
}

// Akun internal saja (Petugas & Admin).
// Masyarakat tidak punya akun (lihat docs/DATABASE.md bagian 2).
model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String // bcrypt hash, tidak pernah plaintext
  role      Role     @default(PETUGAS)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments       Comment[]
  statusHistories StatusHistory[]
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reports Report[]
}

model Report {
  id              String       @id @default(cuid())
  reportNumber    String       @unique
  trackingCode    String       @unique
  categoryId      String
  title           String
  description     String
  location        String
  incidentDate    DateTime
  reporterName    String
  reporterContact String
  status          ReportStatus @default(DIAJUKAN)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  category        Category        @relation(fields: [categoryId], references: [id])
  attachments     Attachment[]
  comments        Comment[]
  statusHistories StatusHistory[]

  @@index([status])
  @@index([categoryId])
}

model Attachment {
  id        String   @id @default(cuid())
  reportId  String
  fileName  String
  fileUrl   String
  fileType  String
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  reportId  String
  userId    String
  message   String
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}

model StatusHistory {
  id        String       @id @default(cuid())
  reportId  String
  userId    String
  status    ReportStatus
  note      String?
  createdAt DateTime     @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
}
