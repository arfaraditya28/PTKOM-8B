          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/admin/users/{{userId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Petugas Pengujian\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "21 Nonaktifkan akun",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/users/{{userId}}"
      }
    },
    {
      "name": "22 Tambah layanan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/admin/services",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Surat Keterangan Uji\",\n  \"description\": \"Layanan pengujian backend.\",\n  \"requirements\": \"KTP dan KK\",\n  \"hours\": \"08.00\\u201315.00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code >= 200 && pm.response.code < 300) {",
              "const r = pm.response.json();",
              "pm.collectionVariables.set(\"serviceId\", r.data.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "23 Ubah layanan",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/admin/services/{{serviceId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contact\": \"Loket kecamatan\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "24 Layanan publik",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/services"
      }
    },
    {
