        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/categories/{{categoryId}}"
      }
    },
    {
      "name": "29 Logout semua sesi",
      "request": {
